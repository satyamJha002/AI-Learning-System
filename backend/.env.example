PORT=8000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
NODE_ENV=production

# Backblaze B2 (optional – if set, uploads go to B2 instead of local disk)
# Get these from Backblaze B2 → Application Keys
# B2_APPLICATION_KEY_ID=your_key_id
# B2_APPLICATION_KEY=your_application_key
# B2_BUCKET_NAME=your_bucket_name
# B2_REGION=us-west-004
# B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your_bucket_name

# Add any other API keys here (e.g., GEMINI_API_KEY if used)
